{
  "name": "@frost.js/core",
  "version": "0.1.2",
  "description": "Core configuration, contracts, diagnostics, env loading, and shared types for Frost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli-ui": {
      "types": "./dist/cli-ui.d.ts",
      "import": "./dist/cli-ui.js"
    }
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/strip-dist-tests.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-bader/Frost.git",
    "directory": "packages/core"
  },
  "keywords": [
    "framework",
    "frost",
    "full-stack",
    "react",
    "ssr"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "author": "Frost contributors",
  "homepage": "https://frostjs.dev",
  "bugs": {
    "url": "https://github.com/ben-bader/Frost/issues"
  }
}
