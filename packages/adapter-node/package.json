{
  "name": "@frostjs/adapter-node",
  "version": "0.1.0",
  "description": "Production Node.js HTTP adapter, static asset server, and SSR runner for Frost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@frostjs/core": "workspace:*",
    "@frostjs/router": "workspace:*",
    "@frostjs/server": "workspace:*",
    "@frostjs/react": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  }
}
