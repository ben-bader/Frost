{
  "name": "@frostjs/vite",
  "version": "0.1.0",
  "description": "Vite plugin integration, virtual route modules, and dev SSR middleware for Frost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@frostjs/core": "workspace:*",
    "@frostjs/router": "workspace:*",
    "@frostjs/server": "workspace:*",
    "@frostjs/react": "workspace:*",
    "@frostjs/adapter-node": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  }
}
