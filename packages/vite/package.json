{
  "name": "@frost.js/vite",
  "version": "0.1.0",
  "description": "Vite plugin integration, virtual route modules, and dev SSR middleware for Frost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@frost.js/core": "workspace:*",
    "@frost.js/router": "workspace:*",
    "@frost.js/server": "workspace:*",
    "@frost.js/react": "workspace:*",
    "@frost.js/adapter-node": "workspace:*",
    "@frost.js/data": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-bader/Frost.git",
    "directory": "."
  },
  "keywords": [
    "frost",
    "react",
    "ssr",
    "framework",
    "full-stack"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
