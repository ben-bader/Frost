{
  "name": "@frost.js/react",
  "version": "0.1.1",
  "description": "React bindings for Frost: hydration, context, hooks, Link, document, error boundary, client router",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "typesVersions": {
    "*": {
      "index": ["./dist/index.d.ts"],
      "client": ["./dist/client.d.ts"]
    }
  },
  "dependencies": {
    "@frost.js/core": "workspace:^",
    "@frost.js/router": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/strip-dist-tests.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-bader/Frost.git",
    "directory": "packages/react"
  },
  "keywords": [
    "framework",
    "frost",
    "full-stack",
    "react",
    "ssr"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "author": "Frost contributors",
  "homepage": "https://frostjs.dev",
  "bugs": {
    "url": "https://github.com/ben-bader/Frost/issues"
  }
}
