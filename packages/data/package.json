{
  "name": "@frost.js/data",
  "version": "0.1.1",
  "description": "CSRF, form parsing, request memoization, and server functions for Frost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@frost.js/core": "workspace:^"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/strip-dist-tests.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-bader/Frost.git",
    "directory": "packages/data"
  },
  "keywords": [
    "framework",
    "frost",
    "full-stack",
    "react",
    "ssr"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "author": "Frost contributors",
  "homepage": "https://frostjs.dev",
  "bugs": {
    "url": "https://github.com/ben-bader/Frost/issues"
  }
