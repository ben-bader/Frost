{
  "name": "@frost.js/data",
  "version": "0.1.0",
  "description": "Server-only data functions, request deduplication, form actions, and mutation contracts for Frost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@frost.js/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-bader/Frost.git",
    "directory": "."
  },
  "keywords": [
    "frost",
    "react",
    "ssr",
    "framework",
    "full-stack"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
