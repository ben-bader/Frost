{
  "name": "@frostjs/server",
  "version": "0.1.0",
  "description": "Request lifecycle, HTTP responses, API routing, and SSR pipeline for Frost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@frostjs/core": "workspace:*",
    "@frostjs/data": "workspace:*",
    "@frostjs/router": "workspace:*",
    "@frostjs/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public"
  }
}
