{
  "name": "frost-monorepo",
  "private": true,
  "description": "Frost - A React-based full-stack framework with explicit execution, visible caching, and host independence.",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:template": "node scripts/check-template.mjs",
    "version-packages": "changeset version",
    "release:pack": "node scripts/release-pack.mjs",
    "release:check": "node scripts/release-check.mjs",
    "e2e:pack": "node scripts/e2e-pack.mjs",
    "docs:assets": "node scripts/build-readme-assets.mjs",
    "docs:check-assets": "node scripts/check-assets.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  }
}
